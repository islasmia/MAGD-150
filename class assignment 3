function setup() {
  createCanvas(900, 900);
  colorMode(RGB)
}
function draw(){
 background (26,0,153);
  
  fill(255,255,0) 
  stroke(255);
  strokeWeight(6)
  ellipse(215,500,255,255); 
  
  beginShape()
  vertex (330,180)
  vertex (250,180)
  vertex (220,95)
  vertex (180,180)
  vertex (100,180)
  vertex (165,235)
  vertex (140,305)
  vertex (215,265)
  vertex (290,305)
  vertex (265,235)
  endShape(CLOSE)

  translate(width / 9, height / 2.5);
  fill('rgb(246,84,248)');
  noStroke();

beginShape(); 
vertex (0,30);
bezierVertex(-50, -30, -30, -70, 0, -20);
bezierVertex(30, -70, 50, -30,0, 30);
endShape(CLOSE)

  let x = frameCount % 100;
  
if (mouseIsPressed === CURVE) {
  framerate(10);
} else {
  frameRate(60);
}
  circle(x, 50,20);
  }
